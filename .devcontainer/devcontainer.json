{
  "name": "C++ SFML Development",
  "image": "mcr.microsoft.com/devcontainers/cpp:1-debian-12",
  "features": {
    // Installs a lightweight desktop environment and a VNC server viewable in-browser
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y libsfml-dev",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  },
  "forwardPorts": [6080]
}